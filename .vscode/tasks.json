{
    "version": "2.0.0",
    "type": "process",
    "command": "fish",
    "options": {
        "cwd": "${workspaceFolder}"
    },
    "tasks": [
        {
            "label": "Spiel bauen",
            "args": ["--no-config", ".vscode/builder.fish", "build"],
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": []
        },
        {
            "label": "Spiel starten",
            "args": ["--no-config", ".vscode/builder.fish", "run"],
            "problemMatcher": []
        },
        {
            "label": "Projekt prüfen",
            "args": ["--no-config", ".vscode/builder.fish", "check"],
            "group": { "kind": "test", "isDefault": true },
            "problemMatcher": []
        },
        {
            "label": "macOS-App exportieren",
            "args": ["--no-config", ".vscode/builder.fish", "export"],
            "problemMatcher": []
        }
    ]
}
