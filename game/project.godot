config_version=5

[application]
config/name="Symbol-Logistik"
config/version="0.1.0"
run/main_scene="res://scenes/start_menu.tscn"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.055, 0.082, 0.071, 1)
config/features=PackedStringArray("4.7", "Forward Plus")

[display]
window/size/viewport_width=1200
window/size/viewport_height=720
window/size/window_width_override=1200
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[input]

camera_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65)]
}

camera_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68)]
}

camera_up={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87)]
}

camera_down={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83)]
}

[rendering]
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.055, 0.082, 0.071, 1)
