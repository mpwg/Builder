{
  "compilerOptions": {
    "target": "ES2025",
    "lib": [
      "ES2025",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "types": [
      "node",
      "bun"
    ]
  },
  "include": [
    "src",
    "tests",
    "*.config.ts"
  ]
}
